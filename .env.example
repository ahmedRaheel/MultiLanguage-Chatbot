POSTGRES_DB=chatbot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
DATABASE_URL=postgresql+psycopg://postgres:postgres123@localhost:5432/chatbot
DOCKER_DATABASE_URL=postgresql+psycopg://postgres:postgres123@postgres:5432/chatbot

# Generate a long random secret for production, e.g. openssl rand -hex 32
JWT_SECRET_KEY=change-this-development-secret-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Development bootstrap admin. Change these values before first production run.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@chatbot.local
ADMIN_PASSWORD=ChangeMe123!

OLLAMA_BASE_URL=http://localhost:11434
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=all-minilm
EMBEDDING_DIMENSION=384

TOP_K=5
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
MAX_UPLOAD_MB=25
CACHE_SIMILARITY_THRESHOLD=0.94

COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000
